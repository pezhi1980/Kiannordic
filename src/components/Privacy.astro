---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n/content';
import { company } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const mail = company.email;
---
{lang === 'da' ? (
<Base lang="da" page="privacy" title="Privatlivspolitik · Kian Nordic" description="Sådan behandler Kian Nordic personoplysninger.">
  <article class="wrap"><div class="prose">
    <h1>Privatlivspolitik</h1>
    <p class="updated">Senest opdateret 16. oktober 2026</p>

    <h2>Dataansvarlig</h2>
    <p>{company.name}, Danmark{company.cvr && `, CVR-nr. ${company.cvr}`}. Kontakt: <a href={`mailto:${mail}`}>{mail}</a>.</p>

    <h2>Ingen cookies og ingen tracking</h2>
    <p>Hjemmesiden bruger ingen cookies, ingen analyseværktøjer og ingen tracking. Skrifttyper hentes fra vores egen server, ikke fra tredjeparter.</p>

    <h2>Når du skriver til os</h2>
    <p>Kontaktformularen sender ikke data til os. Den åbner dit eget mailprogram. Når du sender en e-mail, behandler vi dit navn, din e-mailadresse og indholdet af beskeden for at kunne svare dig og eventuelt give et tilbud. Retsgrundlaget er GDPR artikel 6, stk. 1, litra b (forhold forud for en aftale) og litra f (vores legitime interesse i at besvare henvendelser).</p>

    <h2>Opbevaring</h2>
    <p>Vi sletter henvendelser, når de er afsluttet og senest 12 måneder efter sidste kontakt, medmindre vi indgår et samarbejde, hvor andre regler gælder, f.eks. bogføringsloven.</p>

    <h2>Hosting</h2>
    <p>Vores hostingudbyder kan registrere tekniske oplysninger som IP-adresse i serverlogfiler for at drive og beskytte hjemmesiden. Oplysningerne bruges ikke til at identificere dig.</p>

    <h2>Dine rettigheder</h2>
    <p>Du har ret til indsigt, berigtigelse, sletning, begrænsning af behandling, dataportabilitet og til at gøre indsigelse. Skriv til <a href={`mailto:${mail}`}>{mail}</a>. Du kan også klage til <a href="https://www.datatilsynet.dk">Datatilsynet</a>.</p>
  </div></article>
</Base>
) : (
<Base lang="en" page="privacy" title="Privacy policy · Kian Nordic" description="How Kian Nordic handles personal data.">
  <article class="wrap"><div class="prose">
    <h1>Privacy policy</h1>
    <p class="updated">Last updated 16 October 2026</p>

    <h2>Data controller</h2>
    <p>{company.name}, Denmark{company.cvr && `, CVR no. ${company.cvr}`}. Contact: <a href={`mailto:${mail}`}>{mail}</a>.</p>

    <h2>No cookies and no tracking</h2>
    <p>This website uses no cookies, no analytics and no tracking. Fonts are served from our own server, not from third parties.</p>

    <h2>When you write to us</h2>
    <p>The contact form does not send data to us. It opens your own email app. When you send an email, we process your name, email address and the content of your message to reply and possibly make an offer. The legal basis is GDPR Article 6(1)(b) (steps prior to a contract) and 6(1)(f) (our legitimate interest in answering enquiries).</p>

    <h2>Retention</h2>
    <p>We delete enquiries once they are closed and no later than 12 months after last contact, unless we start working together and other rules apply, such as Danish bookkeeping law.</p>

    <h2>Hosting</h2>
    <p>Our hosting provider may record technical information such as IP addresses in server logs to operate and protect the website. This information is not used to identify you.</p>

    <h2>Your rights</h2>
    <p>You have the right of access, rectification, erasure, restriction of processing, data portability and to object. Write to <a href={`mailto:${mail}`}>{mail}</a>. You can also complain to the Danish Data Protection Agency, <a href="https://www.datatilsynet.dk">Datatilsynet</a>.</p>
  </div></article>
</Base>
)}
