---
import Base from '../layouts/Base.astro';
import Fjord from './Fjord.astro';
import AIDemo from './AIDemo.astro';
import { content, type Lang } from '../i18n/content';
import { company } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
---
<Base lang={lang} page="home">
  <section class="hero">
    <div class="mesh" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#kontakt">{t.hero.primary}</a>
          <a class="btn btn-ghost" href="#ydelser">{t.hero.secondary}</a>
        </div>
      </div>
      <AIDemo lang={lang} />
    </div>
    <Fjord />
  </section>

  <section class="block services" id="ydelser" aria-labelledby="ydelser-h">
    <div class="mesh mesh-soft" aria-hidden="true"><span class="blob b2"></span><span class="blob b3"></span></div>
    <div class="wrap">
      <h2 id="ydelser-h">{t.services.title}</h2>
      <ul class="cards">
        {t.services.items.map((s) => (
          <li class="card glass">
            <span class="icon" aria-hidden="true">
              {s.icon === 'app' && <svg viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M12 8.5l1 2.2 2.2 1-2.2 1-1 2.2-1-2.2-2.2-1 2.2-1z"/></svg>}
              {s.icon === 'llm' && <svg viewBox="0 0 24 24"><path d="M4 5.5h16v10H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/></svg>}
              {s.icon === 'vision' && <svg viewBox="0 0 24 24"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3.5h3M3 3.5v3M21 3.5h-3M21 3.5v3M3 20.5h3M3 20.5v-3M21 20.5h-3M21 20.5v-3"/></svg>}
              {s.icon === 'agent' && <svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><circle cx="12" cy="12.5" r="2.4"/><path d="M12 7v3.1M10.1 14l-3.6 2.6M13.9 14l3.6 2.6"/></svg>}
            </span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <ul class="tags">{s.tags.map((tag) => <li>{tag}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block" id="proces" aria-labelledby="proces-h">
    <div class="wrap">
      <h2 id="proces-h">{t.process.title}</h2>
      <ol class="steps">
        {t.process.steps.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="why-h">
    <div class="wrap split">
      <h2 id="why-h">{t.why.title}</h2>
      <dl class="why">
        {t.why.items.map((w) => (
          <div>
            <dt>{w.name}</dt>
            <dd>{w.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="block contact" id="kontakt" aria-labelledby="kontakt-h">
    <div class="wrap"><div class="panel glass split">
      <div>
        <h2 id="kontakt-h">{t.contact.title}</h2>
        <p class="intro">{t.contact.lead}</p>
      </div>
      <form class="mailform" data-email={company.email} data-subject={t.contact.subject}>
        <div class="field">
          <label for="f-name">{t.contact.name}</label>
          <input id="f-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-email">{t.contact.email}</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-msg">{t.contact.message}</label>
          <textarea id="f-msg" name="message" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit">{t.contact.submit}</button>
        <p class="note">{t.contact.note}</p>
        <p class="direct">{t.contact.or} <a href={`mailto:${company.email}`}>{company.email}</a></p>
      </form>
    </div></div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form.mailform');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const body = `${d.get('message')}\n\n— ${d.get('name')} <${d.get('email')}>`;
    const href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(form.dataset.subject || '')}&body=${encodeURIComponent(body)}`;
    window.location.href = href;
  });
</script>
